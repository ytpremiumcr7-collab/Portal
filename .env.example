NODE_ENV=development
DATABASE_URL=mysql://usuario:password@localhost:3306/ares
ARES_STORAGE_PATH=./storage

# Sólo para poblar una base limpia con un administrador inicial.
SEED_TENANT_NAME=Organización Piedra Angular
SEED_TENANT_RFC=XAXX010101000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambia-esta-clave-por-una-segura

# Registro público de organizaciones (producción: false por defecto)
ARES_ALLOW_PUBLIC_REGISTER=false

# Trust X-Forwarded-For only behind a known reverse proxy
ARES_TRUST_PROXY=false

# SMTP outbox: unset => REGISTRADA; http(s):// => webhook; smtp(s):// => nodemailer
# ARES_SMTP_URL=smtp://user:pass@mail.example:587
# ARES_SMTP_URL=https://hooks.example/mail
# ARES_SMTP_FROM=noreply@entidad.gob.mx
OUTBOX_ADAPTER=log

# Discrete SMTP (alternative to ARES_SMTP_URL)
# SMTP_HOST=mail.example.gov.mx
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@entidad.gob.mx
# SMTP_SECURE=false
# SMTP_TIMEOUT_MS=15000
# OUTBOX_LEASE_MINUTES=15
# OUTBOX_POLL_MS=10000
# OUTBOX_LOOP=0

# Economic envelope AES-256-GCM (32-byte base64 or 64-char hex)
# ARES_ENVELOPE_KEY=
# ARES_ENVELOPE_KEY_VERSION=1
# Rotation stub (decrypt-only for older envelopes):
# ARES_ENVELOPE_KEY_V1=
# ARES_ENVELOPE_KEY_V2=

# Legacy plaintext migration (ops): npm run migrate:legacy-sobres
# Without ARES_ENVELOPE_KEY, rows are flagged only; convocante montos stay blocked.


# e.firma / FIEL (CRYPTO_SIGNATURE) — SAT OCSP + CA bundle under api/lib/firma/sat-cas/
# PA_EFIRMA_OCSP=1
# PA_EFIRMA_OCSP_FAIL_OPEN=0
# PA_EFIRMA_SAT_CAS_DIR=./api/lib/firma/sat-cas
